APP_NAME="CRM Event"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base MySQL commune aux deux équipes
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm_event
DB_USERNAME=root
DB_PASSWORD=

# --- Fronts (ports fixés dans apps/*/vite.config.ts) ---
FRONTEND_GESTION_URL=http://localhost:5173
FRONTEND_CLIENT_URL=http://localhost:5174

# Front ouvert depuis la racine de l'API en local (client | gestion).
# Laisser vide pour conserver l'ancien comportement (404 sur /).
FRONTEND_LOCAL_ENTRY=

# Origines autorisées à s'authentifier par cookie (host:port, sans schéma)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174,127.0.0.1:5173,127.0.0.1:5174

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@crm-event.test"
MAIL_FROM_NAME="${APP_NAME}"
