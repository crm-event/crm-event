{
    "name": "crm-event",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev:gestion": "npm run dev -w @crm-event/gestion",
        "dev:client": "npm run dev -w @crm-event/client",
        "build": "npm run build --workspaces --if-present",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "api:openapi": "cd api && php artisan scramble:export --path=../packages/api-types/openapi.json",
        "api:types": "openapi-typescript packages/api-types/openapi.json -o packages/api-types/index.d.ts",
        "types": "npm run api:openapi && npm run api:types"
    },
    "devDependencies": {
        "openapi-typescript": "^7.6.0"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
